# Public, non-secret configuration for lab 01.
# Copy to .env and fill in your own values. Never commit .env.

AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=rg-ailab-foundations
AZURE_LOCATION=eastus

# Must be globally unique: it becomes the custom domain.
FOUNDRY_RESOURCE_NAME=<globally-unique-foundry-resource-name>
FOUNDRY_PROJECT_NAME=ailab-foundations

# Format: https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=<project-endpoint-printed-by-provision.ps1>

# Cost guardrails
BUDGET_AMOUNT=10
RESOURCE_EXPIRY=<YYYY-MM-DD>

# Authentication is keyless. Do not add an API key here.

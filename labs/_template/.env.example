# Public, non-secret configuration for this lab.
# Copy to .env and fill in your own values. Never commit .env.

AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=rg-ailab-lab
AZURE_LOCATION=eastus

FOUNDRY_RESOURCE_NAME=<globally-unique-foundry-resource-name>
FOUNDRY_PROJECT_NAME=ailab-lab
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

MODEL_DEPLOYMENT_NAME=<your-model-deployment-name>

# Authentication is keyless. Do not add an API key here.

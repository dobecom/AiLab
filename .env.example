# AiLab frontend build configuration
#
# Only public, non-secret build-time values belong here.
# Azure, Microsoft Foundry and model credentials must never appear in the
# browser bundle. Live Foundry features are served by Core-Server at
# /api/v1/ailab/* using DefaultAzureCredential or Managed Identity.

# Absolute origin used for canonical URL, Open Graph and sitemap generation.
VITE_SITE_URL=http://127.0.0.1:2050

# Local Vite dev/preview ports (container binding is 127.0.0.1:2050 -> 80).
VITE_DEV_SERVER_PORT=2050
VITE_PREVIEW_PORT=2050
